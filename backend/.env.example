DATABASE_URL=postgresql+psycopg2://rephore:rephore@postgres:5432/rephore
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# v1 log watcher: interval digest analisis log (jam); 0 = hanya manual via admin
LOG_ANALYSIS_INTERVAL_HOURS=24

# Enkripsi API key provider (at-rest, Fernet). Opsional: bila tidak diset,
# master key dibuat otomatis dan disimpan di volume rephore-secrets.
# Untuk produksi, generate satu key dan set di sini, lalu BACKUP nilainya —
# bila key hilang, API key tersimpan tidak bisa didekripsi lagi.
# Cara generate (PowerShell): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#REPHORE_MASTER_KEY=

# Lampiran file artikel: direktori penyimpanan & batas ukuran per file (MB)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=500
